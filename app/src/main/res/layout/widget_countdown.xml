<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Background layer for customizable rounded color -->
    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="background"
        android:src="@drawable/widget_background"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true" />

    <!-- Timer Block (Centered) -->
    <LinearLayout
        android:id="@+id/timerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Title -->
        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Deadline Title)"
            android:textColor="@color/onSurface"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Deadline Date -->
        <TextView
            android:id="@+id/widgetDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon, Apr 29 10:00 PM"
            android:textColor="@color/onSurface"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Timer -->
        <TextView
            android:id="@+id/widgetTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00:00"
            android:textColor="@color/onSurface"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <!-- Progress Bars (style + adaptive color variants); only one is visible at a time -->
        <!-- solid-blue (default existing) -->
        <ProgressBar
            android:id="@+id/widgetProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_bar"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarSolidYellow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_solid_yellow"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarSolidRed"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_solid_red"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarDashedBlue"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_dashed_blue"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarDashedYellow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_dashed_yellow"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarDashedRed"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_dashed_red"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarGradientBlue"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_gradient_blue"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarGradientYellow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_gradient_yellow"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widgetProgressBarGradientRed"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_gradient_red"
            android:visibility="gone" />

        <!-- Percentage -->
        <TextView
            android:id="@+id/widgetProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="34%"
            android:textSize="12sp"
            android:textColor="@color/onSurface"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Refresh Icon (Right-Aligned) -->
    <ImageView
        android:id="@+id/widgetRefreshBtn"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/refresh_cycle_normal"
        android:contentDescription="refresh"
        app:tint="@color/onSurface"
        android:visibility="visible"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" />

</RelativeLayout>
