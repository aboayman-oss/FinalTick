<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 🔝 Title and Preview -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurface" android:orientation="vertical"
        android:paddingTop="16dp" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingBottom="1dp">

        <TextView android:id="@+id/tvCustomizeTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" android:layout_marginBottom="12dp"
            android:text="Customize Widget"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="5dp" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:paddingBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp"
                    android:text="Widget Preview"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <include layout="@layout/view_fake_widget" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 🧩 Scrollable Cards Section -->
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Appearance Section -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAppearance"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="12dp" app:cardElevation="2dp"
                android:layout_marginBottom="16dp" android:padding="12dp">

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:padding="15dp">

                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Appearance"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="12dp" />

                    <!-- Shape selection -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="12dp">

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Shape"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.chip.ChipGroup android:id="@+id/chipShapeGroup"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipShapeRounded"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Rounded" />

                            <com.google.android.material.chip.Chip android:id="@+id/chipShapePill"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Pill" />

                            <com.google.android.material.chip.Chip android:id="@+id/chipShapeSquare"
                                style="@style/Widget.Material3.Chip.Assist.Elevated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Square" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- Background Color Row (moved here) -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="12dp">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Background"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />

                        <View android:id="@+id/colorPreviewBackground" android:layout_width="36dp"
                            android:layout_height="36dp" android:layout_marginEnd="8dp"
                            android:background="@drawable/color_preview_background"
                            android:contentDescription="Select Background Color" />

                        <Button android:id="@+id/btnResetBackgroundColor"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Default" />
                    </LinearLayout>

                    <!-- Background Opacity Row (moved here) -->
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:layout_marginBottom="4dp">

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView android:id="@+id/tvBackgroundOpacityLabel"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Background Opacity"
                                android:textSize="14sp" android:textColor="?attr/colorOnSurface" />

                            <TextView android:id="@+id/tvBackgroundOpacityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="80%"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBackgroundAlpha"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="255" android:stepSize="1" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:fillViewport="true"
                android:scrollbars="none">

                <!-- Row of 2 equal cards -->
                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:paddingHorizontal="8dp" android:layout_marginBottom="16dp"
                    android:divider="?android:attr/dividerHorizontal" android:showDividers="middle"
                    android:dividerPadding="4dp">

                    <!-- Display Style Card -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="140dp"
                        android:layout_height="match_parent" app:cardCornerRadius="12dp"
                        app:cardElevation="2dp" android:layout_marginEnd="8dp"
                        android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent" android:orientation="vertical"
                            android:padding="15dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Display Style"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:layout_marginBottom="8dp" />

                            <RadioGroup android:id="@+id/timeFormatRadioGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:orientation="vertical"
                                android:gravity="top">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbColonFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Colon" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbLetterFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Letter" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbNaturalLanguageFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Language" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbVerboseSingleUnitFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Verbose" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbCountdownWordsFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Countdown" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbProgressOnlyFormat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Progress" />
                            </RadioGroup>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Time Format Card -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="160dp"
                        android:layout_height="match_parent" app:cardCornerRadius="12dp"
                        app:cardElevation="2dp" android:layout_marginEnd="8dp"
                        android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent" android:orientation="vertical"
                            android:padding="15dp">

                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Time Format"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:layout_marginBottom="8dp" />

                            <!-- Space evenly between rows using weight -->
                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="0dp" android:layout_weight="1"
                                android:orientation="vertical" android:gravity="center_vertical">

                                <!-- Repeatable row structure -->
                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Days"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbDays" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Hours"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbHours"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Minutes"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbMinutes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Seconds"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbSeconds"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Show/Hide Elements Card -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="200dp"
                        android:layout_height="wrap_content" app:cardCornerRadius="12dp"
                        app:cardElevation="2dp" android:padding="12dp">

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent" android:orientation="vertical"
                            android:padding="15dp">

                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Content"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout android:layout_width="match_parent"
                                android:layout_height="0dp" android:layout_weight="1"
                                android:orientation="vertical" android:gravity="center_vertical">

                                <!-- Repeated Switch Row -->
                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Title"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Date/Time"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbDate" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Refresh Icon"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbIcon" android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Timer"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbTimer"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Progress Bar"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbProgress"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>

                                <LinearLayout android:layout_width="match_parent"
                                    android:layout_height="0dp" android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" android:text="Percentage"
                                        android:textSize="14sp"
                                        android:textColor="?attr/colorOnSurface" />

                                    <com.google.android.material.materialswitch.MaterialSwitch
                                        android:id="@+id/cbPercentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>


            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp"
                android:paddingHorizontal="8dp">

                <!-- Change Color Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardColorCustomization" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="100"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp"
                    android:layout_marginStart="4dp" android:padding="12dp">

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="match_parent" android:orientation="vertical"
                        android:padding="15dp">

                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Colors & Fonts"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="16dp" />

                        <!-- Color customization options -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">

                            <!-- Left-aligned label -->
                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Title" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" />

                            <!-- Color preview box -->
                            <View android:id="@+id/colorPreviewTitle" android:layout_width="36dp"
                                android:layout_height="36dp" android:layout_marginEnd="8dp"
                                android:background="@drawable/color_preview_background"
                                android:contentDescription="Select Title Color" />

                            <!-- Reset to default button -->
                            <Button android:id="@+id/btnResetTitleColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Default" />
                        </LinearLayout>
                        <!-- Date & Time Color -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">

                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="@string/date_time" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" />

                            <View android:id="@+id/colorPreviewDate" android:layout_width="36dp"
                                android:layout_height="36dp" android:layout_marginEnd="8dp"
                                android:background="@drawable/color_preview_background"
                                android:contentDescription="Select Date Color" />

                            <Button android:id="@+id/btnResetDateColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Default" />
                        </LinearLayout>

                        <!-- Refresh Icon Color -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">

                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Refresh Icon" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" />

                            <View android:id="@+id/colorPreviewIcon" android:layout_width="36dp"
                                android:layout_height="36dp" android:layout_marginEnd="8dp"
                                android:background="@drawable/color_preview_background"
                                android:contentDescription="Select Icon Color" />

                            <Button android:id="@+id/btnResetIconColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Default" />
                        </LinearLayout>

                        <!-- Timer Color -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">

                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Timer" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" />

                            <View android:id="@+id/colorPreviewTimer" android:layout_width="36dp"
                                android:layout_height="36dp" android:layout_marginEnd="8dp"
                                android:background="@drawable/color_preview_background"
                                android:contentDescription="Select Timer Color" />

                            <Button android:id="@+id/btnResetTimerColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Default" />
                        </LinearLayout>

                        <!-- Background controls moved to Appearance section above -->

                        <!-- Progress % Color -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center_vertical" android:layout_marginBottom="12dp">

                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Progress %" android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface" />

                            <View android:id="@+id/colorPreviewPercentage"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/color_preview_background"
                                android:contentDescription="Select Percentage Color" />

                            <Button android:id="@+id/btnResetPercentageColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Default" />
                        </LinearLayout>

                        <Button android:id="@+id/btnResetAllColors"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Reset to Defaults" android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ✅ Fixed Bottom Action Buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp"
        android:background="?attr/colorSurface" android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton android:id="@+id/btnResetDefaults"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_gravity="start"
            android:layout_marginEnd="10dp" android:layout_weight="1"
            android:text="Reset to Defaults" android:textColor="?attr/colorPrimary"
            app:icon="@drawable/history" app:iconGravity="textStart" app:iconPadding="8dp"
            app:iconSize="22dp" app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveCustomize"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_gravity="end" android:layout_weight="1"
            android:backgroundTint="?attr/colorPrimary" android:text="Done"
            android:textColor="?android:attr/textColorPrimaryInverse" app:icon="@drawable/succ"
            app:iconGravity="textStart" app:iconPadding="8dp" app:iconSize="22dp"
            app:iconTint="?android:attr/textColorPrimaryInverse" />
    </LinearLayout>
</LinearLayout>

